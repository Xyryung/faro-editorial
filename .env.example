# Copia este archivo como .env y completa tus valores.
# .env está en .gitignore: NUNCA lo subas ni pegues claves en Notion, capturas o logs.

# 1 = solo caché local (demo y pruebas sin internet ni claves). 0 = llamadas en vivo.
OFFLINE=1

# OpenRouter: una sola clave para Jev (decisiones) y el LLM (generación).
OPENROUTER_API_KEY=
# Opcional: solo si usan la API de OpenAI directamente en lugar de OpenRouter.
OPENAI_API_KEY=

# Modelos: fijar IDs exactos, nunca alias que cambian solos (p. ej. "latest").
JEV_MODEL=typesafe/jev-1.13
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Las fechas se guardan en UTC; la interfaz las muestra en esta zona.
DISPLAY_TIMEZONE=America/Panama