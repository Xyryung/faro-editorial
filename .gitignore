# --- Secretos y entorno local (NUNCA subir) ---
.env
.env.*
!.env.example
.streamlit/secrets.toml

# --- Python ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Datos (ver data/README.md) ---
# El repo es público: ningún dato entra hasta confirmar condiciones de
# redistribución con la organización. Se ignora TODO data/ (también carpetas
# nuevas como data/entrenamiento/) salvo el README y los .gitkeep.
data/*
!data/README.md
!data/raw/
!data/processed/
!data/cache/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/cache/*
!data/cache/.gitkeep
*.duckdb
*.duckdb.wal

# --- Modelos descargados ---
models/

# --- Editor y sistema operativo ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db